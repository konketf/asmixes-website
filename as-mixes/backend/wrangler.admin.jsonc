{
  "name": "as-mixes-admin",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./admin", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "vars": {
    "APP_MODE": "admin",
    "ADMIN_ORIGIN": "https://as-mixes-admin.YOUR-SUBDOMAIN.workers.dev",
    "ACCESS_TEAM_DOMAIN": "YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE-WITH-ACCESS-APPLICATION-AUD",
    "STORAGE_QUOTA_BYTES": "1073741824"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "as-mixes-portfolio", "database_id": "REPLACE-WITH-D1-ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "as-mixes-media" }],
  "triggers": { "crons": ["17 * * * *"] }
}
