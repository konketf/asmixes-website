{
  "name": "as-mixes-portfolio",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "routes": [{ "pattern": "api.asmixes.com", "custom_domain": true }],
  "preview_urls": false,
  "ratelimits": [
    { "name": "CONTACT_IP_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONTACT_TOTAL_RATE", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "READ_IP_RATE", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } },
    { "name": "READ_TOTAL_RATE", "namespace_id": "1004", "simple": { "limit": 3000, "period": 60 } }
  ],
  "vars": {
    "APP_MODE": "public", "PUBLIC_ORIGIN": "https://asmixes.com",
    "CONTACT_ALLOWED_ORIGINS": "[\"https://asmixes.com\",\"https://www.asmixes.com\"]",
    "CONTACT_IP_LIMIT": "5", "CONTACT_DAILY_LIMIT": "100"
  },
  "triggers": { "crons": ["23 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "as-mixes-portfolio", "database_id": "f6ccfbaf-f772-4f9b-a9d1-11e2d086715b", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "as-mixes-media" }]
}
